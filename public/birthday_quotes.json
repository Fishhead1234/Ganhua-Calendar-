[
  {
    "id": "bday_01",
    "quote": "祝你生日快樂！雖然老了一歲，但別難過，因為你的存款也沒有變多。",
    "subtext": "時間只帶走了膠原蛋白，沒帶來財富自由",
    "character": "cat",
    "category": "general",
    "sceneId": "cat_birthday",
    "assetPath": "/assets/scenes/cat_birthday.webp",
    "spriteSheet": "/assets/sheets/cat_sheet.jpg",
