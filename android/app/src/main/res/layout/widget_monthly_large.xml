<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_monthly_large_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/iv_monthly_large_canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:contentDescription="@string/widget_label_monthly_large" />

    <!-- Interactive Touch Overlay strictly aligned with 800x800 canvas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:weightSum="800"
        android:background="@android:color/transparent">

        <!-- Top Header Bar (Height 82 / 800) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="82"
            android:orientation="horizontal"
            android:weightSum="800">

            <!-- Title touch area (tap to open app) -->
            <FrameLayout
                android:id="@+id/header_title_touch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="480"
                android:clickable="true"
                android:background="@android:color/transparent" />

            <!-- Prev Month Button '<' -->
            <FrameLayout
                android:id="@+id/btn_widget_prev_month"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="100"
                android:clickable="true"
                android:background="@android:color/transparent" />

            <!-- Today Button '今日' -->
            <FrameLayout
                android:id="@+id/btn_widget_today"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="120"
                android:clickable="true"
                android:background="@android:color/transparent" />

            <!-- Next Month Button '>' -->
            <FrameLayout
                android:id="@+id/btn_widget_next_month"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="100"
                android:clickable="true"
                android:background="@android:color/transparent" />
        </LinearLayout>

        <!-- Weekday Row Spacer (Height 58 / 800) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="58"
            android:background="@android:color/transparent" />

        <!-- 6-Row Grid of 42 Cells (Height 68 * 6 = 408 / 800) -->
        <!-- Row 0 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="68"
            android:orientation="horizontal"
            android:weightSum="700">
            <FrameLayout android:id="@+id/cell_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
            <FrameLayout android:id="@+id/cell_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
            <FrameLayout android:id="@+id/cell_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
            <FrameLayout android:id="@+id/cell_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
            <FrameLayout android:id="@+id/cell_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
            <FrameLayout android:id="@+id/cell_5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
            <FrameLayout android:id="@+id/cell_6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
        </LinearLayout>

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="68"
            android:orientation="horizontal"
            android:weightSum="700">
            <FrameLayout android:id="@+id/cell_7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
            <FrameLayout android:id="@+id/cell_8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
            <FrameLayout android:id="@+id/cell_9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
            <FrameLayout android:id="@+id/cell_10" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
            <FrameLayout android:id="@+id/cell_11" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
            <FrameLayout android:id="@+id/cell_12" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
            <FrameLayout android:id="@+id/cell_13" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="68"
            android:orientation="horizontal"
            android:weightSum="700">
            <FrameLayout android:id="@+id/cell_14" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
            <FrameLayout android:id="@+id/cell_15" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
            <FrameLayout android:id="@+id/cell_16" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
            <FrameLayout android:id="@+id/cell_17" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
            <FrameLayout android:id="@+id/cell_18" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
            <FrameLayout android:id="@+id/cell_19" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
            <FrameLayout android:id="@+id/cell_20" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
        </LinearLayout>

        <!-- Row 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="68"
            android:orientation="horizontal"
            android:weightSum="700">
            <FrameLayout android:id="@+id/cell_21" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
            <FrameLayout android:id="@+id/cell_22" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
            <FrameLayout android:id="@+id/cell_23" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
            <FrameLayout android:id="@+id/cell_24" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
            <FrameLayout android:id="@+id/cell_25" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
            <FrameLayout android:id="@+id/cell_26" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
            <FrameLayout android:id="@+id/cell_27" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
        </LinearLayout>

        <!-- Row 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="68"
            android:orientation="horizontal"
            android:weightSum="700">
            <FrameLayout android:id="@+id/cell_28" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
            <FrameLayout android:id="@+id/cell_29" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
            <FrameLayout android:id="@+id/cell_30" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
            <FrameLayout android:id="@+id/cell_31" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
            <FrameLayout android:id="@+id/cell_32" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
            <FrameLayout android:id="@+id/cell_33" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
            <FrameLayout android:id="@+id/cell_34" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
        </LinearLayout>

        <!-- Row 5 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="68"
            android:orientation="horizontal"
            android:weightSum="700">
            <FrameLayout android:id="@+id/cell_35" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
            <FrameLayout android:id="@+id/cell_36" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
            <FrameLayout android:id="@+id/cell_37" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
            <FrameLayout android:id="@+id/cell_38" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
            <FrameLayout android:id="@+id/cell_39" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
            <FrameLayout android:id="@+id/cell_40" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
            <FrameLayout android:id="@+id/cell_41" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:clickable="true" android:background="@android:color/transparent" />
        </LinearLayout>

        <!-- Bottom Detail Panel (Height 252 / 800) -->
        <FrameLayout
            android:id="@+id/widget_bottom_panel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="252"
            android:clickable="true"
            android:background="@android:color/transparent" />
    </LinearLayout>
</FrameLayout>
