<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_calendar_bg">

    <!-- Binder Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:background="@drawable/widget_binder_header"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">

        <FrameLayout
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/widget_rivet" />

        <TextView
            android:id="@+id/tv_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="GAN-HUA CALENDAR"
            android:textColor="@color/widget_header_text"
            android:textSize="10sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/widget_rivet" />
    </LinearLayout>

    <!-- Calendar Content Body -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp">

        <!-- Left Date Column -->
        <LinearLayout
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingRight="6dp">

            <TextView
                android:id="@+id/tv_widget_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10月 / OCT"
                android:textColor="@color/widget_text_muted"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_widget_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30"
                android:textColor="@color/widget_text_title"
                android:textSize="32sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tv_widget_lunar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="農曆九月三十"
                android:textColor="@color/widget_text_muted"
                android:textSize="8sp" />
        </LinearLayout>

        <!-- Vertical Divider (FrameLayout for strict RemoteViews compatibility) -->
        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/widget_divider_color"
            android:layout_marginRight="8dp" />

        <!-- Right Quote Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Top Row: Character Badge + Red Seal -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="2dp">

                <TextView
                    android:id="@+id/tv_widget_character"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🐱 厭世社畜貓"
                    android:textColor="@color/widget_text_badge"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_widget_seal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_stamp_circle"
                    android:paddingLeft="5dp"
                    android:paddingTop="1dp"
                    android:paddingRight="5dp"
                    android:paddingBottom="1dp"
                    android:text="今日已生還"
                    android:textColor="@color/widget_seal_red"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Main Sarcastic Quote -->
            <TextView
                android:id="@+id/tv_widget_quote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="「每天都想辭職，但每天都準時上班。」"
                android:textColor="@color/widget_text_title"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Yi / Ji Advice -->
            <TextView
                android:id="@+id/tv_widget_yiji"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="宜：大杯冰美式・準時關機 / 忌：週五臨時會"
                android:textColor="@color/widget_text_muted"
                android:textSize="8sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

