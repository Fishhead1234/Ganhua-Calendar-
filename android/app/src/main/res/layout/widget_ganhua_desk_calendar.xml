<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_calendar_bg"
    android:padding="0dp">

    <!-- Binder Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:background="@drawable/widget_binder_header"
        android:paddingHorizontal="14dp">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:background="@drawable/widget_rivet" />

        <TextView
            android:id="@+id/tv_widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="幹話日曆 • 每日生存指南"
            android:textColor="#F9F6F0"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:background="@drawable/widget_rivet" />
    </RelativeLayout>

    <!-- Calendar Content Body -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Left Date Column -->
        <LinearLayout
            android:layout_width="80dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/tv_widget_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10月 / OCT"
                android:textColor="#6E6A63"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_widget_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="29"
                android:textColor="#2D2D2D"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_widget_lunar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="農曆九月廿九"
                android:textColor="#6E6A63"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Vertical Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#2D2D2D"
            android:alpha="0.2"
            android:layout_marginEnd="10dp" />

        <!-- Right Quote Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <!-- Top Row: Character Badge + Red Seal -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/tv_widget_character"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="🐱 厭世社畜貓"
                    android:textColor="#785A3C"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_widget_seal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/widget_stamp_circle"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:text="平安下班"
                    android:textColor="#C83E31"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Main Sarcastic Quote -->
            <TextView
                android:id="@+id/tv_widget_quote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="「每天都想辭職，但每天都準時上班。」"
                android:textColor="#2D2D2D"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Yi / Ji Advice -->
            <TextView
                android:id="@+id/tv_widget_yiji"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="宜：大杯冰美式・準時關機 / 忌：週五臨時會"
                android:textColor="#6E6A63"
                android:textSize="9sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

