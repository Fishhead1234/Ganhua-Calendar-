<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Explicit Package Visibility queries for Android 11+ to launch Instagram -->
    <queries>
        <package android:name="com.instagram.android" />
        <intent>
            <action android:name="com.instagram.share.ADD_TO_STORY" />
            <data android:mimeType="image/png" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="image/png" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="instagram" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Native Android Desk Calendar Widget Provider (4x2 Daily) -->
        <receiver
            android:name=".GanhuaWidgetProvider"
            android:label="@string/widget_label_daily"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_ganhua_info" />
        </receiver>

        <!-- Native Android Monthly Split Widget Provider (4x2 Split) -->
        <receiver
            android:name=".MonthlySplitWidgetProvider"
            android:label="@string/widget_label_monthly_split"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_monthly_split_info" />
        </receiver>

        <!-- Native Android Monthly Large Widget Provider (4x4 Full Month) -->
        <receiver
            android:name=".MonthlyLargeWidgetProvider"
            android:label="@string/widget_label_monthly_large"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.ganhuacalendar.app.ACTION_WIDGET_PREV_MONTH" />
                <action android:name="com.ganhuacalendar.app.ACTION_WIDGET_NEXT_MONTH" />
                <action android:name="com.ganhuacalendar.app.ACTION_WIDGET_TODAY" />
                <action android:name="com.ganhuacalendar.app.ACTION_WIDGET_SELECT_DATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_monthly_large_info" />
        </receiver>

        <!-- Native Android Survival Stamp Widget Provider (1x1 One-Tap Stamp) -->
        <receiver
            android:name=".SurvivalStampWidgetProvider"
            android:label="@string/widget_label_survival_stamp"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.ganhuacalendar.app.ACTION_STAMP_TODAY" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_survival_stamp_info" />
        </receiver>

        <!-- Native Appointment Reminder Receiver -->
        <receiver
            android:name=".EventReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.ganhuacalendar.app.ACTION_EVENT_REMINDER" />
            </intent-filter>
        </receiver>

        <!-- Boot Receiver for Auto-Rescheduling Calendar Alarms -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
</manifest>
